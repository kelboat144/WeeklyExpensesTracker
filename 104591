import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        double[] expenses = new double[7];
        double total = 0;

        for (int i = 0; i < expenses.length; i++) {
            System.out.print(
                    "Enter expense for day " + (i + 1) + ": GH₵"
            );

            expenses[i] = input.nextDouble();
            total += expenses[i];
        }

        double average = total / expenses.length;

        System.out.printf(
                "%nTotal weekly expense: GH₵%.2f%n", total
        );

        System.out.printf(
                "Average daily expense: GH₵%.2f%n", average
        );

        input.close();
    }
}
